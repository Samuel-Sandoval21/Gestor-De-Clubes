@model GestorDeClubes.MVC.ViewModels.RolCrearViewModel

@{
    ViewData["Title"] = "Crear rol";
}

<div class="row justify-content-center">

    <div class="col-lg-8 col-xl-7">

        <div class="mb-4">
            <h2 class="mb-1">Crear rol</h2>

            <p class="text-muted mb-0">
                Registre un nuevo rol para el sistema.
            </p>
        </div>

        <div class="card shadow-sm">

            <div class="card-body p-4">

                <form asp-action="Crear"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="Nombre"
                               class="form-label">
                        </label>

                        <input asp-for="Nombre"
                               class="form-control"
                               autocomplete="off" />

                        <span asp-validation-for="Nombre"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-4">

                        <label asp-for="Descripcion"
                               class="form-label">
                        </label>

                        <textarea asp-for="Descripcion"
                                  class="form-control"
                                  rows="4">
                        </textarea>

                        <span asp-validation-for="Descripcion"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Crear rol
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}