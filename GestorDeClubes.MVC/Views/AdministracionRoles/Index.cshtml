@model IEnumerable<GestorDeClubes.MVC.ViewModels.RolListaViewModel>

@{
    ViewData["Title"] = "Administración de roles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Administración de roles</h2>
        <p class="text-muted mb-0">
            Gestione los roles y permisos del sistema.
        </p>
    </div>

    <a asp-action="Crear"
       class="btn btn-primary">
        Crear rol
    </a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["MensajeExito"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No existen roles registrados.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var rol in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @rol.Nombre
                                </td>

                                <td>
                                    @rol.Descripcion
                                </td>

                                <td>
                                    @if (rol.EsRolBase)
                                    {
                                        <span class="badge bg-secondary">
                                            Base
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">
                                            Personalizado
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (rol.Estado)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <span class="text-muted small">
                                        Próximamente
                                    </span>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>