@model GestorDeClubes.MVC.ViewModels.UsuarioCrearViewModel

@{
    ViewData["Title"] = "Crear usuario";

    var roles = ViewBag.Roles as List<string>
        ?? new List<string>();
}

<div class="container py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">

        <h2 class="fw-bold" style="color: #100c83;">
            Crear usuario
        </h2>

        <p class="text-muted">
            Registrá un nuevo usuario con sus credenciales institucionales.
        </p>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0" style="color: #100c83;">
                Información del usuario
            </h5>
        </div>

        <div class="card-body p-4">

            <form asp-controller="AdministracionUsuarios"
                  asp-action="Crear"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- ERRORES GENERALES -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <!-- NOMBRE -->
                    <div class="col-md-6">

                        <label asp-for="Nombre"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Nombre"
                               class="form-control"
                               maxlength="150" />

                        <span asp-validation-for="Nombre"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- APELLIDOS -->
                    <div class="col-md-6">

                        <label asp-for="Apellidos"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Apellidos"
                               class="form-control"
                               maxlength="150" />

                        <span asp-validation-for="Apellidos"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- CORREO -->
                    <div class="col-md-12">

                        <label asp-for="CorreoInstitucional"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="CorreoInstitucional"
                               class="form-control"
                               type="email"
                               maxlength="256"
                               placeholder="usuario@ufide.ac.cr" />

                        <span asp-validation-for="CorreoInstitucional"
                              class="text-danger small">
                        </span>

                        <div class="form-text">
                            Dominios permitidos: ufide.ac.cr y ufidelitas.ac.cr
                        </div>

                    </div>

                    <!-- CONTRASEÑA -->
                    <div class="col-md-6">

                        <label asp-for="Password"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Password"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="Password"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- CONFIRMAR CONTRASEÑA -->
                    <div class="col-md-6">

                        <label asp-for="ConfirmarPassword"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="ConfirmarPassword"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmarPassword"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- REQUISITOS DE CONTRASEÑA -->
                    <div class="col-12">

                        <div class="alert alert-light border small mb-0">

                            <strong>Requisitos de contraseña:</strong>

                            Mínimo 8 caracteres, una mayúscula,
                            una minúscula, un número y un carácter especial.

                        </div>

                    </div>

                    <!-- ROL -->
                    <div class="col-md-12">

                        <label asp-for="Rol"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="Rol"
                                class="form-select">

                            <option value="">
                                -- Seleccione un rol --
                            </option>

                            @foreach (var rol in roles)
                            {
                                <option value="@rol">
                                    @rol
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Rol"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <!-- BOTONES -->
                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-controller="AdministracionUsuarios"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar usuario
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}