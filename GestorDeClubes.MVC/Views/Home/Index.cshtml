@{
    ViewData["Title"] = "Panel Principal";
}

<div class="mb-5 text-center">
    <h1 class="display-5 fw-bold" style="color: #0A00A4;">¡Bienvenido al Gestor de Clubes!</h1>
    <p class="lead text-muted">Centraliza la administración de clubes, eventos y la comunicación institucional.</p>
    <hr class="my-4" style="border-color: #E6007E; width: 100px; margin: 0 auto;">
</div>

<!-- Sección de Estadísticas Rápidas -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 text-white" style="background: linear-gradient(135deg, #0A00A4 0%, #2b1db5 100%);">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-white-50">Clubes Activos</h6>
                        <h2 class="mb-0 fw-bold">@ViewBag.ClubesActivos</h2>
                    </div>
                    <i class="fas fa-people-arrows fa-3x text-white-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 text-white" style="background: linear-gradient(135deg, #E6007E 0%, #c4006a 100%);">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-white-50">Eventos Próximos</h6>
                        <h2 class="mb-0 fw-bold">@ViewBag.EventosProximos</h2>
                    </div>
                    <i class="fas fa-calendar-check fa-3x text-white-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 text-white" style="background: linear-gradient(135deg, #FFCE00 0%, #e0b500 100%); color: #0A00A4 !important;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase" style="color: #0A00A4;">Miembros Totales</h6>
                        <h2 class="mb-0 fw-bold">@ViewBag.MiembrosTotales</h2>
                    </div>
                    <i class="fas fa-user-graduate fa-3x" style="color: #0A00A4;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sección de Acciones Rápidas (Según el Rol) -->
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                <h5 class="fw-bold text-dark"><i class="fas fa-list me-2 text-primary"></i> Actividades Recientes</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-edit text-primary me-2"></i>
                            <span class="fw-bold">Club de Fotografía</span> actualizó su descripción.
                        </div>
                        <small class="text-muted">Hace 2 horas</small>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-user-plus text-success me-2"></i>
                            <span class="fw-bold">Alejandro</span> se unió al club de Ajedrez.
                        </div>
                        <small class="text-muted">Hace 4 horas</small>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-calendar-plus text-warning me-2"></i>
                            Nuevo evento: <span class="fw-bold">Taller de Liderazgo</span> creado.
                        </div>
                        <small class="text-muted">Ayer</small>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                <h5 class="fw-bold text-dark"><i class="fas fa-clock me-2 text-secondary"></i> Próximos Eventos</h5>
            </div>
            <div class="card-body">
                <!-- Lista de Eventos Simulada -->
                <div class="d-flex align-items-start mb-3 border-bottom pb-3">
                    <div class="bg-primary text-white rounded p-2 text-center me-3" style="width: 50px;">
                        <small>OCT</small>
                        <strong>15</strong>
                    </div>
                    <div>
                        <h6 class="mb-0 text-dark">Taller de Desarrollo Web</h6>
                        <small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i> STEM Center - Aula 103</small>
                    </div>
                </div>
                <div class="d-flex align-items-start mb-3 border-bottom pb-3">
                    <div class="bg-danger text-white rounded p-2 text-center me-3" style="width: 50px;">
                        <small>NOV</small>
                        <strong>02</strong>
                    </div>
                    <div>
                        <h6 class="mb-0 text-dark">Torneo de Ajedrez</h6>
                        <small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i> Salón de Usos Múltiples</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>