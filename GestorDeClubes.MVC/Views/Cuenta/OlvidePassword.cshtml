@model GestorDeClubes.MVC.ViewModels.OlvidePasswordViewModel

@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Recuperar contraseña - Gestor de Clubes</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            :root {
                --color-primario: #10069F;
                --color-secundario: #0D0585;
            }

            body {
                min-height: 100vh;
                margin: 0;
                background: #FFFFFF;
                color: #344054;
                font-family: 'Segoe UI', sans-serif;
            }

            .recuperacion-container {
                width: 100%;
                max-width: 620px;
                margin: 0 auto;
                padding: 54px 30px;
            }

            .marca {
                color: var(--color-primario);
                font-size: 22px;
                font-weight: 700;
                margin-bottom: 42px;
            }

            .marca-subtitulo {
                color: #667085;
                font-size: 13px;
                font-weight: 400;
            }

            .titulo {
                font-size: 29px;
                font-weight: 400;
                margin-bottom: 14px;
            }

            .pregunta {
                font-size: 21px;
                font-weight: 400;
                margin-bottom: 22px;
            }

            .descripcion {
                color: #667085;
                font-size: 14px;
                margin-bottom: 26px;
            }

            .form-label {
                font-size: 14px;
                font-weight: 500;
            }

            .form-control {
                max-width: 430px;
                padding: 10px 12px;
                border-color: #98A2B3;
                border-radius: 4px;
            }

                .form-control:focus {
                    border-color: var(--color-primario);
                    box-shadow: 0 0 0 3px rgba(16, 6, 159, 0.12);
                }

            .ejemplo {
                color: #667085;
                font-size: 12px;
                margin-top: 6px;
            }

            .acciones {
                display: flex;
                align-items: center;
                gap: 18px;
                margin-top: 34px;
            }

            .btn-siguiente {
                padding: 9px 24px;
                border: none;
                border-radius: 3px;
                background: var(--color-primario);
                color: #FFFFFF;
                font-size: 14px;
            }

                .btn-siguiente:hover {
                    background: var(--color-secundario);
                    color: #FFFFFF;
                }

            .cancelar {
                color: var(--color-primario);
                font-size: 14px;
                text-decoration: none;
            }

                .cancelar:hover {
                    text-decoration: underline;
                }

            .validation-summary-errors ul {
                padding-left: 20px;
            }
    </style>
</head>

<body>

    <main class="recuperacion-container">

        <!-- Identidad del sistema -->

        <div class="marca">
            <i class="bi bi-mortarboard-fill me-2"></i>
            Gestor de Clubes

            <div class="marca-subtitulo mt-1">
                Universidad Fidélitas
            </div>
        </div>

        <!-- Encabezado -->

        <h1 class="titulo">
            Recuperá tu cuenta
        </h1>

        <h2 class="pregunta">
            ¿Cuál es tu correo institucional?
        </h2>

        <p class="descripcion">
            Para recuperar el acceso a tu cuenta, comenzá por
            ingresar el correo electrónico institucional asociado
            a tu usuario.
        </p>

        <!-- Formulario -->

        <form asp-controller="Cuenta"
              asp-action="OlvidePassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger small mb-3"
                 role="alert">
            </div>

            <div class="mb-3">

                <label asp-for="CorreoInstitucional"
                       class="form-label">
                    Correo institucional:
                    <span class="text-danger">*</span>
                </label>

                <input asp-for="CorreoInstitucional"
                       type="email"
                       class="form-control"
                       placeholder="usuario@ufide.ac.cr"
                       autocomplete="email"
                       required />

                <span asp-validation-for="CorreoInstitucional"
                      class="text-danger small">
                </span>

                <div class="ejemplo">
                    Ejemplo: usuario@ufide.ac.cr
                </div>

            </div>

            <!-- Acciones -->

            <div class="acciones">

                <button type="submit"
                        class="btn btn-siguiente">
                    Siguiente
                </button>

                <a asp-controller="Cuenta"
                   asp-action="Login"
                   class="cancelar">
                    Cancelar
                </a>

            </div>

        </form>

    </main>

</body>
</html>