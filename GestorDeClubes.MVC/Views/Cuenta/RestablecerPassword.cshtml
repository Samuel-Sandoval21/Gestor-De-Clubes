
@model GestorDeClubes.MVC.ViewModels.RestablecerPasswordViewModel

@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Restablecer contraseña - Gestor de Clubes</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --color-primario: #10069F;
            --color-secundario: #0D0585;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background: #FFFFFF;
            color: #344054;
            font-family: 'Segoe UI', sans-serif;
        }

        .recuperacion-container {
            width: 100%;
            max-width: 620px;
            margin: 0 auto;
            padding: 54px 30px;
        }

        .marca {
            color: var(--color-primario);
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 42px;
        }

        .marca-subtitulo {
            color: #667085;
            font-size: 13px;
            font-weight: 400;
        }

        .titulo {
            font-size: 29px;
            font-weight: 400;
            margin-bottom: 14px;
        }

        .descripcion {
            color: #667085;
            font-size: 14px;
            line-height: 1.7;
            margin-bottom: 28px;
        }

        .form-label {
            color: #344054;
            font-size: 14px;
            font-weight: 600;
        }

        .form-control {
            padding: 11px;
            border-color: #D0D5DD;
        }

        .form-control:focus {
            border-color: var(--color-primario);
            box-shadow: 0 0 0 3px rgba(16, 6, 159, 0.12);
        }

        .input-group-text {
            background: #F8FAFC;
            border-color: #D0D5DD;
            color: #667085;
        }

        .btn-toggle-password {
            background: #F8FAFC;
            border: 1px solid #D0D5DD;
            color: #667085;
            padding: 0 14px;
        }

        .btn-toggle-password:hover {
            background: #EEF2F6;
            color: var(--color-primario);
        }

        .btn-toggle-password:focus-visible {
            outline: 2px solid var(--color-primario);
            outline-offset: 2px;
        }

        .requisitos {
            color: #667085;
            font-size: 12px;
            margin-top: 8px;
        }

        .btn-restablecer {
            padding: 11px 22px;
            background: var(--color-primario);
            border: none;
            border-radius: 5px;
            color: #FFFFFF;
            font-weight: 600;
        }

        .btn-restablecer:hover {
            background: var(--color-secundario);
            color: #FFFFFF;
        }

        .cancelar {
            color: var(--color-primario);
            font-size: 14px;
            text-decoration: none;
        }

        .cancelar:hover {
            text-decoration: underline;
        }

        .acciones {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-top: 28px;
        }

        .validation-summary-errors ul {
            padding-left: 20px;
        }
    </style>
</head>

<body>

    <main class="recuperacion-container">

        <!-- Identidad del sistema -->

        <div class="marca">
            <i class="bi bi-mortarboard-fill me-2"></i>
            Gestor de Clubes

            <div class="marca-subtitulo mt-1">
                Universidad Fidélitas
            </div>
        </div>

        <!-- Encabezado -->

        <h1 class="titulo">
            Establecé una nueva contraseña
        </h1>

        <p class="descripcion">
            Ingresá una nueva contraseña para recuperar
            el acceso a tu cuenta institucional.
        </p>

        <!-- Formulario -->

        <form asp-controller="Cuenta"
              asp-action="RestablecerPassword"
              method="post">

            @Html.AntiForgeryToken()

            <!-- Datos necesarios para validar la recuperación -->

            <input asp-for="Correo" type="hidden" />

            <input asp-for="Token" type="hidden" />

            <!-- Errores generales -->

            <div asp-validation-summary="ModelOnly"
                 class="text-danger small mb-3"
                 role="alert">
            </div>

            <!-- Nueva contraseña -->

            <div class="mb-3">

                <label asp-for="NuevaPassword"
                       class="form-label">
                    Nueva contraseña
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-lock"></i>
                    </span>

                    <input asp-for="NuevaPassword"
                           type="password"
                           class="form-control"
                           placeholder="Ingresá tu nueva contraseña"
                           autocomplete="new-password" />

                    <button type="button"
                            class="btn btn-toggle-password"
                            data-password-target="NuevaPassword"
                            aria-label="Mostrar nueva contraseña"
                            aria-pressed="false"
                            title="Mostrar nueva contraseña">

                        <i class="bi bi-eye"
                           aria-hidden="true"></i>

                    </button>

                </div>

                <span asp-validation-for="NuevaPassword"
                      class="text-danger small">
                </span>

                <p class="requisitos">
                    Utilizá al menos 8 caracteres, incluyendo
                    mayúsculas, minúsculas, números y un símbolo.
                </p>

            </div>

            <!-- Confirmar contraseña -->

            <div class="mb-3">

                <label asp-for="ConfirmarPassword"
                       class="form-label">
                    Confirmar contraseña
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-shield-lock"></i>
                    </span>

                    <input asp-for="ConfirmarPassword"
                           type="password"
                           class="form-control"
                           placeholder="Repetí tu nueva contraseña"
                           autocomplete="new-password" />

                    <button type="button"
                            class="btn btn-toggle-password"
                            data-password-target="ConfirmarPassword"
                            aria-label="Mostrar confirmación de contraseña"
                            aria-pressed="false"
                            title="Mostrar confirmación de contraseña">

                        <i class="bi bi-eye"
                           aria-hidden="true"></i>

                    </button>

                </div>

                <span asp-validation-for="ConfirmarPassword"
                      class="text-danger small">
                </span>

            </div>

            <!-- Acciones -->

            <div class="acciones">

                <button type="submit"
                        class="btn btn-restablecer">

                    Restablecer contraseña

                </button>

                <a asp-controller="Cuenta"
                   asp-action="Login"
                   class="cancelar">

                    Cancelar

                </a>

            </div>

        </form>

    </main>

    <!-- Mostrar u ocultar ambas contraseñas -->

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const botones = document.querySelectorAll(
                "[data-password-target]"
            );

            botones.forEach(function (boton) {

                boton.addEventListener("click", function () {

                    const idCampo = boton.getAttribute(
                        "data-password-target"
                    );

                    const campo = document.getElementById(idCampo);

                    const icono = boton.querySelector("i");

                    if (!campo || !icono) {
                        return;
                    }

                    const mostrar = campo.type === "password";

                    campo.type = mostrar ? "text" : "password";

                    icono.classList.toggle("bi-eye", !mostrar);

                    icono.classList.toggle("bi-eye-slash", mostrar);

                    const descripcion = mostrar
                        ? "Ocultar contraseña"
                        : "Mostrar contraseña";

                    boton.setAttribute("aria-label", descripcion);

                    boton.setAttribute("title", descripcion);

                    boton.setAttribute("aria-pressed", String(mostrar));

                });

            });

        });
    </script>

</body>
</html>