@model GestorDeClubes.MVC.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Iniciar sesión - Gestor de Clubes</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            :root {
                --color-primario: #10069F;
                --color-secundario: #0D0585;
                --color-fondo: #10069F;
            }

            body {
                min-height: 100vh;
                margin: 0;
                background: var(--color-fondo);
                font-family: 'Segoe UI', sans-serif;
            }

            .login-container {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
            }

            .login-card {
                width: 100%;
                max-width: 440px;
                background: #FFFFFF;
                border-radius: 18px;
                padding: 38px;
                box-shadow: 0 10px 35px rgba(0, 40, 80, 0.10);
            }

            .login-icon {
                width: 76px;
                height: 76px;
                margin: 0 auto 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: #E8F1FA;
                color: var(--color-primario);
                font-size: 34px;
            }

            .login-title {
                color: var(--color-primario);
                font-size: 25px;
                font-weight: 700;
                text-align: center;
                margin-bottom: 8px;
            }

            .login-subtitle {
                color: #667085;
                font-size: 14px;
                text-align: center;
                margin-bottom: 30px;
            }

            .form-label {
                color: #344054;
                font-weight: 600;
                font-size: 14px;
            }

            .input-group-text {
                background: #F8FAFC;
                border-color: #D0D5DD;
                color: #667085;
            }

            .form-control {
                padding: 11px;
                border-color: #D0D5DD;
            }

                .form-control:focus {
                    border-color: var(--color-secundario);
                    box-shadow: 0 0 0 3px rgba(0, 90, 156, 0.12);
                }

            /* Botón para mostrar u ocultar la contraseña */

            .btn-toggle-password {
                background: #F8FAFC;
                border: 1px solid #D0D5DD;
                color: #667085;
                padding: 0 14px;
            }

                .btn-toggle-password:hover {
                    background: #EEF2F6;
                    color: var(--color-primario);
                }

                .btn-toggle-password:focus-visible {
                    outline: 2px solid var(--color-primario);
                    outline-offset: 2px;
                }

            .btn-login {
                width: 100%;
                padding: 12px;
                background: var(--color-primario);
                border: none;
                border-radius: 8px;
                color: white;
                font-weight: 600;
                transition: background 0.2s ease;
            }

                .btn-login:hover {
                    background: var(--color-secundario);
                    color: white;
                }

            .forgot-link {
                color: var(--color-secundario);
                font-size: 14px;
                text-decoration: none;
            }

                .forgot-link:hover {
                    text-decoration: underline;
                }

            .login-footer {
                text-align: center;
                margin-top: 28px;
                font-size: 12px;
                color: #98A2B3;
            }

            .validation-summary-errors ul {
                padding-left: 20px;
                margin-bottom: 0;
            }
    </style>
</head>

<body>

    <main class="login-container">

        <div class="login-card">

            <!-- Encabezado -->

            <div class="login-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <h1 class="login-title">
                Gestor de Clubes
            </h1>

            <p class="login-subtitle">
                Universidad Fidélitas
                <br />
                Ingresá con tu cuenta institucional
            </p>

            <!-- Formulario -->

            <form asp-controller="Cuenta"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- Errores generales -->

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3"
                     role="alert">
                </div>

                <!-- Correo institucional -->

                <div class="mb-3">

                    <label asp-for="CorreoInstitucional"
                           class="form-label">
                        Correo institucional
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-envelope"></i>
                        </span>

                        <input asp-for="CorreoInstitucional"
                               type="email"
                               class="form-control"
                               placeholder="usuario@ufide.ac.cr"
                               autocomplete="username" />

                    </div>

                    <span asp-validation-for="CorreoInstitucional"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Contraseña -->

                <div class="mb-3">

                    <label asp-for="Password"
                           class="form-label">
                        Contraseña
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-lock"></i>
                        </span>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Ingresá tu contraseña"
                               autocomplete="current-password" />

                        <!-- Botón para mostrar u ocultar la contraseña -->

                        <button type="button"
                                id="togglePassword"
                                class="btn btn-toggle-password"
                                aria-label="Mostrar contraseña"
                                aria-pressed="false"
                                title="Mostrar contraseña">

                            <i id="passwordIcon"
                               class="bi bi-eye"
                               aria-hidden="true"></i>

                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Recordar sesión -->

                <div class="form-check mb-3">

                    <input asp-for="Recordarme"
                           class="form-check-input" />

                    <label asp-for="Recordarme"
                           class="form-check-label">
                        Recordar sesión
                    </label>

                </div>

                <!-- Iniciar sesión -->

                <button type="submit" class="btn btn-login">

                    <i class="bi bi-box-arrow-in-right me-2"></i>

                    Iniciar sesión

                </button>

                <!-- Recuperación de contraseña -->

                <div class="text-center mt-4">

                    <a asp-controller="Cuenta"
                       asp-action="OlvidePassword"
                       class="forgot-link">

                        ¿Olvidaste tu contraseña?

                    </a>

                </div>

            </form>

            <!-- Pie de página -->

            <div class="login-footer">
                © @DateTime.Now.Year Universidad Fidélitas
                <br />
                Gestor de Clubes Universitarios
            </div>

        </div>

    </main>

    <!-- Mostrar u ocultar contraseña -->

    <script>
            document.addEventListener("DOMContentLoaded", function() {

                const passwordInput =
                    document.getElementById("Password");

                const toggleButton =
                    document.getElementById("togglePassword");

                const passwordIcon =
                    document.getElementById("passwordIcon");

                if (!passwordInput || !toggleButton || !passwordIcon) {
                    return;
                }

                toggleButton.addEventListener("click", function() {

                    const mostrarPassword =
                        passwordInput.type === "password";

                    // Alternar entre texto visible y contraseña oculta.
                    passwordInput.type =
                        mostrarPassword ? "text" : "password";

                    // Actualizar el ícono del ojo.
                    passwordIcon.classList.toggle(
                        "bi-eye",
                        !mostrarPassword
                    );

                    passwordIcon.classList.toggle(
                        "bi-eye-slash",
                        mostrarPassword
                    );

                    // Actualizar la descripción del botón.
                    const descripcion = mostrarPassword
                        ? "Ocultar contraseña"
                        : "Mostrar contraseña";

                    toggleButton.setAttribute(
                        "aria-label",
                        descripcion
                    );

                    toggleButton.setAttribute(
                        "title",
                        descripcion
                    );

                    toggleButton.setAttribute(
                        "aria-pressed",
                        String(mostrarPassword)
                    );

                });

            });
    </script>

</body>
</html>