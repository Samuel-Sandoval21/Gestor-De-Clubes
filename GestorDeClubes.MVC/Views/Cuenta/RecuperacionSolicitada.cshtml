@{
    ViewData["Title"] = "Solicitud de recuperación";
    Layout = null;

    var enlaceDesarrollo =
        TempData["EnlaceRecuperacionDesarrollo"] as string;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Recuperación de contraseña - Gestor de Clubes</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            :root {
                --color-primario: #10069F;
                --color-secundario: #0D0585;
            }

            body {
                min-height: 100vh;
                margin: 0;
                background: #FFFFFF;
                color: #344054;
                font-family: 'Segoe UI', sans-serif;
            }

            .recuperacion-container {
                width: 100%;
                max-width: 620px;
                margin: 0 auto;
                padding: 54px 30px;
            }

            .marca {
                color: var(--color-primario);
                font-size: 22px;
                font-weight: 700;
                margin-bottom: 42px;
            }

            .marca-subtitulo {
                color: #667085;
                font-size: 13px;
                font-weight: 400;
            }

            .titulo {
                font-size: 29px;
                font-weight: 400;
                margin-bottom: 18px;
            }

            .descripcion {
                color: #667085;
                font-size: 15px;
                line-height: 1.7;
            }

            .icono-confirmacion {
                color: var(--color-primario);
                font-size: 44px;
                margin-bottom: 20px;
            }

            .panel-desarrollo {
                margin-top: 30px;
                padding: 20px;
                border: 1px solid #D0D5DD;
                border-radius: 8px;
                background: #F8FAFC;
            }

                .panel-desarrollo h2 {
                    font-size: 17px;
                    font-weight: 600;
                    margin-bottom: 10px;
                }

                .panel-desarrollo p {
                    color: #667085;
                    font-size: 13px;
                }

            .enlace-prueba {
                display: inline-block;
                max-width: 100%;
                padding: 10px 16px;
                border-radius: 5px;
                background: var(--color-primario);
                color: #FFFFFF;
                font-size: 14px;
                text-decoration: none;
            }

                .enlace-prueba:hover {
                    background: var(--color-secundario);
                    color: #FFFFFF;
                }

            .volver {
                display: inline-block;
                margin-top: 30px;
                color: var(--color-primario);
                font-size: 14px;
                text-decoration: none;
            }

                .volver:hover {
                    text-decoration: underline;
                }
    </style>
</head>

<body>

    <main class="recuperacion-container">

        <!-- Identidad del sistema -->

        <div class="marca">
            <i class="bi bi-mortarboard-fill me-2"></i>
            Gestor de Clubes

            <div class="marca-subtitulo mt-1">
                Universidad Fidélitas
            </div>
        </div>

        <!-- Confirmación -->

        <div class="icono-confirmacion">
            <i class="bi bi-envelope-check"></i>
        </div>

        <h1 class="titulo">
            Solicitud recibida
        </h1>

        <p class="descripcion">
            Si el correo institucional ingresado está asociado
            a una cuenta habilitada, recibirás las instrucciones
            para restablecer tu contraseña.
        </p>

        <!-- Enlace simulado: únicamente para desarrollo -->
        @if (!string.IsNullOrWhiteSpace(enlaceDesarrollo))
        {
            <div class="panel-desarrollo">

                <h2>
                    <i class="bi bi-tools me-2"></i>
                    Simulación de correo electrónico
                </h2>

                <p>
                    Este panel es exclusivo del entorno de desarrollo.
                    Como todavía no configuramos un servicio de correo,
                    podés utilizar el siguiente enlace para probar
                    el restablecimiento de contraseña.
                </p>

                <a href="@enlaceDesarrollo"
                   class="enlace-prueba">

                    Continuar con la recuperación

                    <i class="bi bi-arrow-right ms-2"></i>

                </a>

            </div>
        }

        <!-- Regresar al login -->

        <a asp-controller="Cuenta"
           asp-action="Login"
           class="volver">

            <i class="bi bi-arrow-left me-1"></i>
            Volver al inicio de sesión

        </a>

    </main>

</body>
</html>