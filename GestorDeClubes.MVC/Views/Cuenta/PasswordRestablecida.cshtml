@{
    ViewData["Title"] = "Contraseña restablecida";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Contraseña restablecida - Gestor de Clubes</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            :root {
                --color-primario: #10069F;
                --color-secundario: #0D0585;
            }

            body {
                min-height: 100vh;
                margin: 0;
                background: #FFFFFF;
                color: #344054;
                font-family: 'Segoe UI', sans-serif;
            }

            .confirmacion-container {
                width: 100%;
                max-width: 620px;
                margin: 0 auto;
                padding: 54px 30px;
            }

            .marca {
                color: var(--color-primario);
                font-size: 22px;
                font-weight: 700;
                margin-bottom: 42px;
            }

            .marca-subtitulo {
                color: #667085;
                font-size: 13px;
                font-weight: 400;
            }

            .icono-exito {
                color: #16803C;
                font-size: 48px;
                margin-bottom: 20px;
            }

            .titulo {
                font-size: 29px;
                font-weight: 400;
                margin-bottom: 18px;
            }

            .descripcion {
                color: #667085;
                font-size: 15px;
                line-height: 1.7;
                margin-bottom: 30px;
            }

            .btn-login {
                display: inline-block;
                padding: 11px 22px;
                background: var(--color-primario);
                border-radius: 5px;
                color: #FFFFFF;
                font-size: 14px;
                font-weight: 600;
                text-decoration: none;
            }

                .btn-login:hover {
                    background: var(--color-secundario);
                    color: #FFFFFF;
                }
    </style>
</head>

<body>

    <main class="confirmacion-container">

        <!-- Identidad del sistema -->

        <div class="marca">

            <i class="bi bi-mortarboard-fill me-2"></i>
            Gestor de Clubes

            <div class="marca-subtitulo mt-1">
                Universidad Fidélitas
            </div>

        </div>

        <!-- Confirmación del cambio -->

        <div class="icono-exito">
            <i class="bi bi-check-circle-fill"></i>
        </div>

        <h1 class="titulo">
            Contraseña restablecida
        </h1>

        <p class="descripcion">
            Tu contraseña se ha actualizado correctamente.
            Ya podés iniciar sesión con tu correo institucional
            y la nueva contraseña.
        </p>

        <!-- Volver al login -->

        <a asp-controller="Cuenta"
           asp-action="Login"
           class="btn-login">

            <i class="bi bi-box-arrow-in-right me-2"></i>

            Ir al inicio de sesión

        </a>

    </main>

</body>
</html>