@{
    ViewData["Title"] = "Clubes Activos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold" style="color: #0A00A4;"><i class="fas fa-users me-2"></i>Clubes Activos</h2>
    <a asp-controller="Prototipo" asp-action="Clubes" class="btn btn-outline-primary btn-sm disabled">Ver Todos</a>
</div>

<div class="row g-4">
    <!-- Club 1 -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h5 class="card-title fw-bold">Club de Fotografía</h5>
                        <p class="card-text text-muted small">Explora el arte de la fotografía.</p>
                        <span class="badge bg-success">Activo</span>
                    </div>
                    <i class="fas fa-camera fa-2x text-primary opacity-25"></i>
                </div>
                <div class="mt-3">
                    <small class="text-muted"><i class="fas fa-user me-1"></i> Coordinador: Ana Pérez</small><br>
                    <small class="text-muted"><i class="fas fa-users me-1"></i> 25 Miembros</small>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0 pb-3">
                <button class="btn btn-sm btn-primary w-100"><i class="fas fa-plus-circle me-1"></i> Solicitar Ingreso</button>
            </div>
        </div>
    </div>

    <!-- Club 2 -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h5 class="card-title fw-bold">Club de Ajedrez</h5>
                        <p class="card-text text-muted small">Estrategia y pensamiento crítico.</p>
                        <span class="badge bg-success">Activo</span>
                    </div>
                    <i class="fas fa-chess-king fa-2x text-primary opacity-25"></i>
                </div>
                <div class="mt-3">
                    <small class="text-muted"><i class="fas fa-user me-1"></i> Coordinador: Carlos Rojas</small><br>
                    <small class="text-muted"><i class="fas fa-users me-1"></i> 18 Miembros</small>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0 pb-3">
                <button class="btn btn-sm btn-primary w-100"><i class="fas fa-plus-circle me-1"></i> Solicitar Ingreso</button>
            </div>
        </div>
    </div>

    <!-- Club 3 -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h5 class="card-title fw-bold">Club de Robótica</h5>
                        <p class="card-text text-muted small">Creación de prototipos tecnológicos.</p>
                        <span class="badge bg-warning text-dark">En revisión</span>
                    </div>
                    <i class="fas fa-robot fa-2x text-primary opacity-25"></i>
                </div>
                <div class="mt-3">
                    <small class="text-muted"><i class="fas fa-user me-1"></i> Coordinador: Luis Méndez</small><br>
                    <small class="text-muted"><i class="fas fa-users me-1"></i> 12 Miembros</small>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0 pb-3">
                <button class="btn btn-sm btn-secondary w-100 disabled"><i class="fas fa-clock me-1"></i> Pendiente</button>
            </div>
        </div>
    </div>
</div>