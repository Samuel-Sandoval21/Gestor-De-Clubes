                <div class="mt-3 text-end">
                    <button class="btn btn-sm btn-primary"><i class="fas fa-check me-1"></i> Confirmar Asistencia</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="text-center mt-4">
    <a href="/Home/Index" class="btn btn-outline-secondary">← Volver al Panel Principal</a>
</div>