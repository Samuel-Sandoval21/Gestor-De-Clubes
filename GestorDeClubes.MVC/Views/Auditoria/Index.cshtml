@model IEnumerable<GestorDeClubes.Data.Entities.AuditoriaAcceso>

@{
    ViewData["Title"] = "Bitácora de accesos";

    // Las fechas se almacenan en UTC y se muestran
    // en la zona horaria de Costa Rica.
    var zonaCostaRica = TimeZoneInfo.FindSystemTimeZoneById(
        "America/Costa_Rica");
}

<div class="container py-4">

    <!-- Encabezado -->

    <div class="mb-4">
        <h2 class="fw-bold" style="color: #10069F;">
            <i class="bi bi-journal-text me-2"></i>
            Bitácora de accesos
        </h2>

        <p class="text-muted">
            Historial de ingresos y cierres de sesión
            del Gestor de Clubes Universitarios.
        </p>
    </div>

    <!-- Tabla de auditoría -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0" style="color: #10069F;">
                Registros almacenados
            </h5>

        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle me-2"></i>
                    Todavía no existen registros de auditoría.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Correo institucional</th>
                                <th>Evento</th>
                                <th>Fecha y hora (Costa Rica)</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var registro in Model)
                            {
                                var fechaLocal =
                                    TimeZoneInfo.ConvertTimeFromUtc(
                                        DateTime.SpecifyKind(
                                            registro.FechaHora,
                                            DateTimeKind.Utc),
                                        zonaCostaRica);

                                <tr>

                                    <td>
                                        @registro.AuditoriaAccesoID
                                    </td>

                                    <td>
                                        @registro.Usuario.Email
                                    </td>

                                    <td>

                                        @if (registro.TipoEvento == "INGRESO")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                                Ingreso
                                            </span>
                                        }
                                        else if (registro.TipoEvento == "CIERRE")
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-box-arrow-right me-1"></i>
                                                Cierre
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">
                                                @registro.TipoEvento
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @fechaLocal.ToString("dd/MM/yyyy hh:mm:ss tt")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>